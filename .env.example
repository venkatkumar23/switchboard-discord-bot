# Local development secrets. Copy to .env (`cp .env.example .env`) — .env is git-ignored.
# Production values are set with `npx wrangler secret put <NAME>` (see README → Deploy).

# Discord Developer Portal → your app → General Information
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# Discord Developer Portal → your app → OAuth2 → Client Secret ("Connect a server" flow)
DISCORD_CLIENT_SECRET=
# Discord Developer Portal → your app → Bot → Reset Token
DISCORD_BOT_TOKEN=

# 32 random bytes, base64. Encrypts mirror webhook URLs at rest in D1.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Optional AI triage through any OpenAI-compatible API with a free, no-card tier.
# Groq (default): https://console.groq.com/keys
AI_API_KEY=
# Override provider/model if you like (Gemini: https://generativelanguage.googleapis.com/v1beta/openai)
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-20b
