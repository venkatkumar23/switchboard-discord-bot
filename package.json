{
  "name": "switchboard",
  "version": "1.0.0",
  "private": true,
  "description": "Discord slash-command bot with a durable job pipeline and an admin dashboard, on Cloudflare Workers + D1.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "register": "tsx scripts/register-commands.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "smoke": "tsx scripts/smoke.ts",
    "demo:setup": "tsx scripts/dev-setup.ts",
    "demo:mock": "tsx scripts/mock-discord.ts",
    "demo:admin": "tsx scripts/create-admin.ts --email admin@demo.local --password demo-password --guild 200000000000000001",
    "simulate": "tsx scripts/simulate.ts",
    "demo:cron": "node -e \"setInterval(()=>fetch('http://localhost:5173/cdn-cgi/handler/scheduled').then(r=>console.log(new Date().toISOString(),'cron tick',r.status)).catch(e=>console.error(e.message)),60000);console.log('Ticking the local cron every 60s (Ctrl+C to stop)')\""
  },
  "dependencies": {
    "hono": "^4.13.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261002.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "tweetnacl": "^1.0.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "~4.1.11",
    "wrangler": "^4.147.0"
  }
}
